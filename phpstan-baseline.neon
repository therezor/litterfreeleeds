			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:syncPermissions\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Filament/Resources/Roles/Pages/CreateRole.php

		-
			message: '#^Cannot call method translatedFormat\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Http/Controllers/CommunityPickController.php

		-
			message: '#^Access to an undefined property App\\Models\\CommunityPick\:\:\$formatted_postcode\.$#'
			identifier: property.notFound
